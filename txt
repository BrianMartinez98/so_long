#include <fcntl.h>
#include <stdlib.h>
#include "get_next_line.h" // tu propia implementación de GNL

char	**allocate_map_array(int lines)
{
	char **map = malloc(sizeof(char *) * (lines + 1));
	if (!map)
		return (NULL);
	map[lines] = NULL;
	return (map);
}

int	count_lines(const char *file_path)
{
	int		fd;
	int		count = 0;
	char	*line;

	fd = open(file_path, O_RDONLY);
	if (fd < 0)
		return (-1);
	while ((line = get_next_line(fd)) != NULL)
	{
		count++;
		free(line);
	}
	close(fd);
	return (count);
}

int	load_map(map_t *map, const char *file_path)
{
	int		fd;
	int		i = 0;
	int		lines;
	char	*line;

	lines = count_lines(file_path);
	if (lines <= 0)
		return (0);
	map->map = allocate_map_array(lines);
	if (!map->map)
		return (0);

	fd = open(file_path, O_RDONLY);
	if (fd < 0)
		return (0);

	while ((line = get_next_line(fd)) != NULL)
	{
		map->map[i] = line; // línea incluye '\n' → puedes quitarlo si quieres
		if (i == 0)
			map->width = ft_strlen(line) - (line[ft_strlen(line) - 1] == '\n');
		i++;
	}
	map->height = i;
	close(fd);
	return (1);
}
